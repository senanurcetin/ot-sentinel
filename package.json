    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.3.0",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-toast": "^1.2.24",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.6",
    "genkit": "^1.20.0",
    "lucide-react": "^1.52.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.1",
