# Genkit requires a Google AI API key to use the Gemini model.
# Create this file as .env in the root directory and add your key.
# Get a key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_API_KEY_HERE

# Optional: put the whole app behind one shared password (HTTP Basic; use HTTPS).
# Format user:password, password at least 12 characters. Leave unset for an open demo.
# DEMO_BASIC_AUTH=operator:choose-a-long-password
