# Genkit requires a Google AI API key to use the Gemini model.
# Create this file as .env in the root directory and add your key.
# Get a key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_API_KEY_HERE

# OPTIONAL shared demo-only HTTP Basic gate. Set ONLY on a protected HTTPS
# deployment; no production credentials or customer/user accounts. Do not
# commit real secrets. Unset = open demo, set but malformed/empty = 503.
# Password must have >=16 chars; a globally shared lockout can be triggered.
# For serious public access, prefer platform SSO/WAF or a VPN in front.
# DEMO_BASIC_AUTH=demo-operator:replace-with-a-long-random-secret
